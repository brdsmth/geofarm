{
  "name": "geofarm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/feeds/*",
    "packages/client/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
